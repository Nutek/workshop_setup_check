BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 2
ColumnLimit: 120
BreakBeforeBinaryOperators: NonAssignment
AlwaysBreakTemplateDeclarations: true
DerivePointerAlignment: false
PointerAlignment: Left

IncludeBlocks: Regroup
IncludeCategories:
  # Matches common headers first, but sorts them after project includes
  - Regex: '^<Windows\.h>'
    Priority: 1

  - Regex: '^<(Dbt|WinUser)\.h>'
    Priority: 2

  - Regex: "^<(gmock|gtest|benchmark|easy)/"
    Priority: 100

  # For Qt headers
  - Regex: "^<Q"
    Priority: 200

  # For Boost headers
  - Regex: '^<boost/.+\.hpp>'
    Priority: 400

  # More global than local
  - Regex: '^<.*\.(h|hpp)>'
    Priority: 500

  # For STD headers
  - Regex: "^<[^/]+>"
    Priority: 300

  - Regex: '^\"'
    Priority: 1000
